# Copy this file to ".env" in the project root and paste your Sarvam key.
#
#   SARVAM_API_KEY=your_key_here
#
# .env is read by the backend only and is never sent to the browser.
# Never commit .env, and never paste your key into chat or code.

SARVAM_API_KEY=

# Optional overrides (defaults shown). Leave commented unless you need them.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_VISION_MODEL=gemma4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_SPEAKER=priya
# SARVAM_TIMEOUT=45
